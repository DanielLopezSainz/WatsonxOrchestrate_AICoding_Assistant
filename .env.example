# Copy this file to .env and fill in your own values. The .env file is ignored by git
# and must never be committed. Chapter 2 explains where each value comes from.
WO_INSTANCE=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WO_API_KEY=
# Chapter 7: a test value that you invent, used as the API key of the city's 311 Call Center.
UTOPIA_311_API_KEY=
# Chapter 10: the Account SID and the Auth Token of your Twilio account, from the console's home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
